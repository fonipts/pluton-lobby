from flask import Flask
(@condition if {
    blueprint == "yes"
} )
from .views.simple_page import simple_page
(@end if )
({   
    @condition{
        database != "none"
    }
    @content{
from flask_sqlalchemy import SQLAlchemy
from sqlalchemy.orm import declarative_base,sessionmaker
from decouple import config

    }

})
#noqa: create the app
app = Flask(__name__)
({   
    @condition{
        database == "postgres"
    }
    @content{
db = SQLAlchemy()
app.config["SQLALCHEMY_DATABASE_URI"] = f'postgresql+psycopg://{config("DB_USER")}:{config("DB_PASSWORD")}@{config("DB_HOST")}/{config("DB_NAME")}'
db.init_app(app)

    }
    @end{}
    @condition{
        database == "mysql"
    }
    @content{
db = SQLAlchemy()
app.config["SQLALCHEMY_DATABASE_URI"] = f'mysql://{config("DB_USER")}:{config("DB_PASSWORD")}@{config("DB_HOST")}/{config("DB_NAME")}'
db.init_app(app)

    }
})
({
    @condition{
        blueprint == "yes"
    }
    @content{
app.register_blueprint(simple_page)
    }
})

@app.route("/")
def hello_world():
    return "<p>Hello world</p>"
@app.route("/heath")
def health():
    return "<p>Server is running</p>"

if __name__ == "__main__":
  app.run()
